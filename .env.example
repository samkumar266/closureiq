# Copy to .env and fill in. Never commit .env.
DATA_MODE=live
NWS_USER_AGENT=ClosureIQ (contact: sxs98450@ucmo.edu)
# Model provider for the Strands agent: akamai or bedrock
MODEL_PROVIDER=akamai
AKAMAI_INFERENCE_URL=
AKAMAI_INFERENCE_KEY=
AKAMAI_MODEL=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Email (the only real channel). Provider: Resend (https://resend.com). No key = log-only mode.
EMAIL_PROVIDER=resend
EMAIL_PROVIDER_KEY=
# Every real email goes to this inbox, whoever it was meant for
DEMO_EMAIL_TO=
# Optional sender; default is Resend's test sender onboarding@resend.dev
EMAIL_FROM=
# Optional: 1 = storm mode, higher simulated delivery failure rates
NOTIFY_STORM_MODE=
# Strands provider configuration
LLM_PROVIDER=bedrock
BEDROCK_MODEL_ID=
ANTHROPIC_API_KEY=
OPENAI_BASE_URL=
OPENAI_API_KEY=
MODEL_ID=
