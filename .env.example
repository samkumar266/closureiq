# Copy to .env and fill in. Never commit .env.
DATA_MODE=live
NWS_USER_AGENT=ClosureIQ (contact: sxs98450@ucmo.edu)
DB_PATH=data/closureiq.db
# Model provider for the Strands agent: akamai or bedrock
MODEL_PROVIDER=akamai
AKAMAI_INFERENCE_URL=
AKAMAI_INFERENCE_KEY=
AKAMAI_MODEL=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Email (the only real channel). Provider: Resend (https://resend.com). No key = log-only mode.
EMAIL_PROVIDER=resend
EMAIL_PROVIDER_KEY=
# Every real email goes to this inbox, whoever it was meant for
DEMO_EMAIL_TO=
# Optional sender; default is Resend's test sender onboarding@resend.dev
EMAIL_FROM=
# Optional: 1 = storm mode, higher simulated delivery failure rates
NOTIFY_STORM_MODE=
# Strands provider configuration
LLM_PROVIDER=openai_compat
BEDROCK_MODEL_ID=
ANTHROPIC_API_KEY=
OPENAI_BASE_URL=https://ws.akamai-workshops.com/v1
OPENAI_API_KEY=
MODEL_ID=hackathon-chat


DATA_MODE=live

HOST=127.0.0.1
PORT=8000
NWS_TIMEOUT_SECONDS=12
NWS_RETRY_SECONDS=5
POLL_ON_STARTUP=true
ENABLE_SCHEDULER=true
# This backend defaults to simulated-only notification delivery.
NOTIFICATION_MODE=simulated

